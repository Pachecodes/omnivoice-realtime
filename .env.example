# Explicit mock engine: emits test tones, NOT speech. No model download.
OMNIVOICE_MOCK=1
# Real engine defaults below; install the optional model dependency separately.
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=cuda:0
OMNIVOICE_DTYPE=float16
OMNIVOICE_ASR_MODEL=openai/whisper-small
OMNIVOICE_ASR_DEVICE=
# Empty values use private per-user defaults; never put voices in this repository.
OMNIVOICE_UPLOAD_DIR=
OMNIVOICE_VOICE_REGISTRY=
OMNIVOICE_MAX_UPLOAD_BYTES=15728640
OMNIVOICE_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Optional local Hugging Face cache, managed by upstream libraries.
HF_HOME=
